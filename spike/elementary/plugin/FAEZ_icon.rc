// FAEZ app icon + version resource.
//
// Pulled in via the JUCE_USER_DEFINED_RC_FILE compile definition, which makes
// JUCE's generated FAEZ_resources.rc `#include` this file INSTEAD of
// its own body. That means this file owns BOTH the icon and the version
// block — drop the version info here and the binary loses it.
//
// The .ico is found via the include dir CMake adds (../scripts), so the
// reference below is bare. Regenerate with `python ../scripts/make_icon.py`.
#pragma code_page(65001)

#undef  WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

IDI_FAZESPIKE ICON "FAEZ.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION  0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",  "Faze\0"
      VALUE "FileDescription",  "PsydeNote\0"
      VALUE "FileVersion",  "0.1.0\0"
      VALUE "ProductName",  "PsydeNote\0"
      VALUE "ProductVersion",  "0.1.0\0"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
